# === AI & ML ===
GEMINI_API_KEY=              # https://aistudio.google.com — create API key (free 1500 req/day)
HF_TOKEN=                    # https://huggingface.co/settings/tokens (free)

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=    # https://supabase.com — new project
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=        # Supabase project settings > API

# === Reddit (for TrendAgent) ===
REDDIT_CLIENT_ID=            # https://reddit.com/prefs/apps — create "script" app
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendFlare/1.0

# === Ayrshare (Social Publishing) ===
AYRSHARE_API_KEY=            # https://ayrshare.com — free account (1 profile)

# === Redis ===
REDIS_URL=redis://localhost:6379/0   # Local dev default; redis.com for prod (free 30MB)

# === Database (local dev — used by docker-compose) ===
POSTGRES_USER=trendflare
POSTGRES_PASSWORD=trendflare_dev
POSTGRES_DB=trendflare
DATABASE_URL=postgresql://trendflare:trendflare_dev@localhost:5432/trendflare

# === Auth ===
NEXTAUTH_SECRET=             # Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# === App ===
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
